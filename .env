# Admin Secret Path - Use a long, unguessable string to hide the admin dashboard URL
# Example: /qs8eYzT2m9kL4pW6xQ (this makes the admin dashboard at /<this_value> instead of /admin)
ADMIN_SECRET_PATH=kR7vJ2mN8pQ4wX5yB9

# Admin Username - Simple username for admin login
ADMIN_USERNAME=admin

# Admin Password - Strong password for admin login (minimum 12 characters recommended)
ADMIN_PASSWORD=SecurePass123!@#

# Allowed IPs for admin access (comma-separated)
# Default: 127.0.0.1,::1 (localhost only)
ADMIN_ALLOWED_IPS=127.0.0.1,::1

# Optional: Token-based access (leave empty to use username/password instead)
# If set, admin can authenticate with either username/password OR this token
# ADMIN_ACCESS_TOKEN=your_secret_token_here
