# Admin Secret Path - Use a long, unguessable string to hide the admin dashboard URL
# This path will be used to access the admin dashboard instead of the default /admin
# Example: if set to 'qs8eYzT2m9kL4pW6xQ', admin dashboard will be at /qs8eYzT2m9kL4pW6xQ instead of /admin
# Generate a random string: openssl rand -hex 12 or use any password generator
ADMIN_SECRET_PATH=your_secret_path_here_change_this

# Admin Username - Username for admin login
# Change this to something secure
ADMIN_USERNAME=admin

# Admin Password - Strong password for admin login
# Use a strong password with uppercase, lowercase, numbers, and special characters
# Minimum 12 characters recommended
ADMIN_PASSWORD=YourSecurePasswordHere!

# Allowed IPs for admin access (comma-separated)
# Only these IPs can access the admin dashboard
# Default: 127.0.0.1,::1 (localhost only)
# Example: 127.0.0.1,::1,192.168.1.100
ADMIN_ALLOWED_IPS=127.0.0.1,::1

# Optional: Token-based access
# If set, admin can authenticate with this token OR username/password
# Leave empty to use only username/password authentication
# ADMIN_ACCESS_TOKEN=your_optional_token_here
